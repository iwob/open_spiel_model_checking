        Environment.turn = player0 and Environment.pile2 >= 19: { pile2_take19 };
        Environment.turn = player0 and Environment.pile3 >= 1: { pile3_take1 };
        Environment.turn = player0 and Environment.pile3 >= 2: { pile3_take2 };
        Environment.turn = player0 and Environment.pile3 >= 3: { pile3_take3 };
        Environment.turn = player0 and Environment.pile3 >= 4: { pile3_take4 };
        Environment.turn = player0 and Environment.pile3 >= 5: { pile3_take5 };
        Environment.turn = player0 and Environment.pile3 >= 6: { pile3_take6 };
        Environment.turn = player0 and Environment.pile3 >= 7: { pile3_take7 };
        Environment.turn = player0 and Environment.pile3 >= 8: { pile3_take8 };
        Environment.turn = player0 and Environment.pile3 >= 9: { pile3_take9 };
        Environment.turn = player0 and Environment.pile3 >= 10: { pile3_take10 };
        Environment.turn = player0 and Environment.pile3 >= 11: { pile3_take11 };
        Environment.turn = player0 and Environment.pile3 >= 12: { pile3_take12 };
        Environment.turn = player0 and Environment.pile3 >= 13: { pile3_take13 };
        Environment.turn = player0 and Environment.pile3 >= 14: { pile3_take14 };
        Environment.turn = player0 and Environment.pile3 >= 15: { pile3_take15 };
        Environment.turn = player0 and Environment.pile3 >= 16: { pile3_take16 };
        Environment.turn = player0 and Environment.pile3 >= 17: { pile3_take17 };
        Other : { none }; -- technicality
    end Protocol
    Evolution:
        null=true if null=true;
    end Evolution
end Agent

