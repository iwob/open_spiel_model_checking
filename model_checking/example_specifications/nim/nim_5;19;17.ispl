        pile3 = pile3 - 10 if pile3 >= 10 and (Player0.Action = pile3_take10 or Player1.Action = pile3_take10);
        pile3 = pile3 - 11 if pile3 >= 11 and (Player0.Action = pile3_take11 or Player1.Action = pile3_take11);
        pile3 = pile3 - 12 if pile3 >= 12 and (Player0.Action = pile3_take12 or Player1.Action = pile3_take12);
        pile3 = pile3 - 13 if pile3 >= 13 and (Player0.Action = pile3_take13 or Player1.Action = pile3_take13);
