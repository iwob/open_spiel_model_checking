    Vars:
        null : boolean; -- for syntax reasons only
    end Vars
    Actions = {pile1_take1, pile1_take2, pile1_take3, pile1_take4, pile1_take5, pile2_take1, pile2_take2, pile2_take3, pile2_take4, pile2_take5, pile2_take6, pile2_take7, pile2_take8, pile2_take9, pile2_take10, pile2_take11, pile2_take12, pile2_take13, pile2_take14, pile2_take15, pile2_take16, pile2_take17, pile2_take18, pile2_take19, pile3_take1, pile3_take2, pile3_take3, pile3_take4, pile3_take5, pile3_take6, pile3_take7, pile3_take8, pile3_take9, pile3_take10, pile3_take11, pile3_take12, pile3_take13, pile3_take14, pile3_take15, pile3_take16, pile3_take17, none};
    Protocol:
        Environment.turn = player0 and Environment.pile1 >= 1: { pile1_take1 };
