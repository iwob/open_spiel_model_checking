Semantics=SingleAssignment;

Agent Environment
    Obsvars:
        turn : {player0, player1};
        pile1 : 0 .. 5;
        pile2 : 0 .. 19;
        pile3 : 0 .. 17;
    end Obsvars
    Actions = { }; 
    Protocol: end Protocol
    Evolution:
        turn = player0 if turn = player1 and (! Player1.Action = none);
        turn = player1 if turn = player0 and (! Player0.Action = none);
        pile1 = pile1 - 1 if pile1 >= 1 and (Player0.Action = pile1_take1 or Player1.Action = pile1_take1);
        pile1 = pile1 - 2 if pile1 >= 2 and (Player0.Action = pile1_take2 or Player1.Action = pile1_take2);
        pile1 = pile1 - 3 if pile1 >= 3 and (Player0.Action = pile1_take3 or Player1.Action = pile1_take3);
