        pile2 = pile2 - 10 if pile2 >= 10 and (Player0.Action = pile2_take10 or Player1.Action = pile2_take10);
        pile2 = pile2 - 11 if pile2 >= 11 and (Player0.Action = pile2_take11 or Player1.Action = pile2_take11);
        pile2 = pile2 - 12 if pile2 >= 12 and (Player0.Action = pile2_take12 or Player1.Action = pile2_take12);
        pile2 = pile2 - 13 if pile2 >= 13 and (Player0.Action = pile2_take13 or Player1.Action = pile2_take13);
        pile2 = pile2 - 14 if pile2 >= 14 and (Player0.Action = pile2_take14 or Player1.Action = pile2_take14);
        pile2 = pile2 - 15 if pile2 >= 15 and (Player0.Action = pile2_take15 or Player1.Action = pile2_take15);
        pile2 = pile2 - 16 if pile2 >= 16 and (Player0.Action = pile2_take16 or Player1.Action = pile2_take16);
        pile2 = pile2 - 17 if pile2 >= 17 and (Player0.Action = pile2_take17 or Player1.Action = pile2_take17);
        pile2 = pile2 - 18 if pile2 >= 18 and (Player0.Action = pile2_take18 or Player1.Action = pile2_take18);
        pile2 = pile2 - 19 if pile2 >= 19 and (Player0.Action = pile2_take19 or Player1.Action = pile2_take19);
        pile3 = pile3 - 1 if pile3 >= 1 and (Player0.Action = pile3_take1 or Player1.Action = pile3_take1);
        pile3 = pile3 - 2 if pile3 >= 2 and (Player0.Action = pile3_take2 or Player1.Action = pile3_take2);
        pile3 = pile3 - 3 if pile3 >= 3 and (Player0.Action = pile3_take3 or Player1.Action = pile3_take3);
        pile3 = pile3 - 4 if pile3 >= 4 and (Player0.Action = pile3_take4 or Player1.Action = pile3_take4);
