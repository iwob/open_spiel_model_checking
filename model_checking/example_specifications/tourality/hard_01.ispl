Agent Player0
Vars:
      null : boolean; -- for syntax reasons only
end Vars
Actions = { up, down, left, right, pass };
Protocol:
      Environment.turn=turn_p0 and (! (Environment.y_p1=0 and Environment.x_p1=0)) and Environment.y_p0=1 and Environment.x_p0=0: { up };
      Environment.turn=turn_p0 and (! (Environment.y_p1=0 and Environment.x_p1=2)) and Environment.y_p0=1 and Environment.x_p0=2: { up };
      Environment.turn=turn_p0 and (! (Environment.y_p1=0 and Environment.x_p1=2)) and Environment.y_p0=0 and Environment.x_p0=3: { left };
      Environment.turn=turn_p0 and (! (Environment.y_p1=0 and Environment.x_p1=3)) and Environment.y_p0=0 and Environment.x_p0=2: { right };
      Environment.turn=turn_p0 and (! (Environment.y_p1=0 and Environment.x_p1=3)) and Environment.y_p0=0 and Environment.x_p0=4: { left };
      Environment.turn=turn_p0 and (! (Environment.y_p1=0 and Environment.x_p1=4)) and Environment.y_p0=1 and Environment.x_p0=4: { up };
      Environment.turn=turn_p0 and (! (Environment.y_p1=0 and Environment.x_p1=4)) and Environment.y_p0=0 and Environment.x_p0=3: { right };
      Environment.turn=turn_p0 and (! (Environment.y_p1=0 and Environment.x_p1=7)) and Environment.y_p0=1 and Environment.x_p0=7: { up };
      Environment.turn=turn_p0 and (! (Environment.y_p1=1 and Environment.x_p1=0)) and Environment.y_p0=0 and Environment.x_p0=0: { down };
      Environment.turn=turn_p0 and (! (Environment.y_p1=1 and Environment.x_p1=0)) and Environment.y_p0=2 and Environment.x_p0=0: { up };
      Environment.turn=turn_p0 and (! (Environment.y_p1=1 and Environment.x_p1=2)) and Environment.y_p0=0 and Environment.x_p0=2: { down };
      Environment.turn=turn_p0 and (! (Environment.y_p1=1 and Environment.x_p1=2)) and Environment.y_p0=2 and Environment.x_p0=2: { up };
