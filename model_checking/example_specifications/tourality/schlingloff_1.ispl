      b_7_5 = block if y_p1 = 7 and x_p1 = 4 and turn = turn_p1 and Player1.Action = right;
      b_7_4 = empty if y_p1 = 7 and x_p1 = 4 and turn = turn_p1 and Player1.Action = right;
      b_7_5 = block if y_p0 = 7 and x_p0 = 6 and turn = turn_p0 and Player0.Action = left;
      b_7_6 = empty if y_p0 = 7 and x_p0 = 6 and turn = turn_p0 and Player0.Action = left;
      b_7_5 = block if y_p1 = 7 and x_p1 = 6 and turn = turn_p1 and Player1.Action = left;
      b_7_6 = empty if y_p1 = 7 and x_p1 = 6 and turn = turn_p1 and Player1.Action = left;
      b_7_6 = block if y_p0 = 6 and x_p0 = 6 and turn = turn_p0 and Player0.Action = down;
      b_6_6 = empty if y_p0 = 6 and x_p0 = 6 and turn = turn_p0 and Player0.Action = down;
      b_7_6 = block if y_p1 = 6 and x_p1 = 6 and turn = turn_p1 and Player1.Action = down;
      b_6_6 = empty if y_p1 = 6 and x_p1 = 6 and turn = turn_p1 and Player1.Action = down;
      b_7_6 = block if y_p0 = 7 and x_p0 = 5 and turn = turn_p0 and Player0.Action = right;
      b_7_5 = empty if y_p0 = 7 and x_p0 = 5 and turn = turn_p0 and Player0.Action = right;
      b_7_6 = block if y_p1 = 7 and x_p1 = 5 and turn = turn_p1 and Player1.Action = right;
      b_7_5 = empty if y_p1 = 7 and x_p1 = 5 and turn = turn_p1 and Player1.Action = right;
      b_7_6 = block if y_p0 = 7 and x_p0 = 7 and turn = turn_p0 and Player0.Action = left;
      b_7_7 = empty if y_p0 = 7 and x_p0 = 7 and turn = turn_p0 and Player0.Action = left;
      b_7_6 = block if y_p1 = 7 and x_p1 = 7 and turn = turn_p1 and Player1.Action = left;
      b_7_7 = empty if y_p1 = 7 and x_p1 = 7 and turn = turn_p1 and Player1.Action = left;
      b_7_7 = block if y_p0 = 6 and x_p0 = 7 and turn = turn_p0 and Player0.Action = down;
      b_6_7 = empty if y_p0 = 6 and x_p0 = 7 and turn = turn_p0 and Player0.Action = down;
      b_7_7 = block if y_p1 = 6 and x_p1 = 7 and turn = turn_p1 and Player1.Action = down;
      b_6_7 = empty if y_p1 = 6 and x_p1 = 7 and turn = turn_p1 and Player1.Action = down;
      b_7_7 = block if y_p0 = 7 and x_p0 = 6 and turn = turn_p0 and Player0.Action = right;
      b_7_6 = empty if y_p0 = 7 and x_p0 = 6 and turn = turn_p0 and Player0.Action = right;
      b_7_7 = block if y_p1 = 7 and x_p1 = 6 and turn = turn_p1 and Player1.Action = right;
      b_7_6 = empty if y_p1 = 7 and x_p1 = 6 and turn = turn_p1 and Player1.Action = right;

      -- positions are updated according to the move
      y_p0 = y_p0 - 1 if turn = turn_p0 and Player0.Action = up;
      y_p0 = y_p0 + 1 if turn = turn_p0 and Player0.Action = down;
      x_p0 = x_p0 - 1 if turn = turn_p0 and Player0.Action = left;
      x_p0 = x_p0 + 1 if turn = turn_p0 and Player0.Action = right;
      y_p1 = y_p1 - 1 if turn = turn_p1 and Player1.Action = up;
      y_p1 = y_p1 + 1 if turn = turn_p1 and Player1.Action = down;
      x_p1 = x_p1 - 1 if turn = turn_p1 and Player1.Action = left;
      x_p1 = x_p1 + 1 if turn = turn_p1 and Player1.Action = right;

      -- board and points are updated according to the moves of the players:
      reward_0 = taken if reward_0 = avail and ((turn = turn_p1 and x_p0 = xreward_0 and y_p0 = yreward_0) or (turn = turn_p0 and x_p1 = xreward_0 and y_p1 = yreward_0));
      reward_1 = taken if reward_1 = avail and ((turn = turn_p1 and x_p0 = xreward_1 and y_p0 = yreward_1) or (turn = turn_p0 and x_p1 = xreward_1 and y_p1 = yreward_1));
      reward_2 = taken if reward_2 = avail and ((turn = turn_p1 and x_p0 = xreward_2 and y_p0 = yreward_2) or (turn = turn_p0 and x_p1 = xreward_2 and y_p1 = yreward_2));
      reward_3 = taken if reward_3 = avail and ((turn = turn_p1 and x_p0 = xreward_3 and y_p0 = yreward_3) or (turn = turn_p0 and x_p1 = xreward_3 and y_p1 = yreward_3));
      reward_4 = taken if reward_4 = avail and ((turn = turn_p1 and x_p0 = xreward_4 and y_p0 = yreward_4) or (turn = turn_p0 and x_p1 = xreward_4 and y_p1 = yreward_4));

      points_p0 = points_p0 + 1 if reward_0 = avail and turn = turn_p1 and x_p0 = xreward_0 and y_p0 = yreward_0;
      points_p1 = points_p1 + 1 if reward_0 = avail and turn = turn_p0 and x_p1 = xreward_0 and y_p1 = yreward_0;
      points_p0 = points_p0 + 1 if reward_1 = avail and turn = turn_p1 and x_p0 = xreward_1 and y_p0 = yreward_1;
      points_p1 = points_p1 + 1 if reward_1 = avail and turn = turn_p0 and x_p1 = xreward_1 and y_p1 = yreward_1;
      points_p0 = points_p0 + 1 if reward_2 = avail and turn = turn_p1 and x_p0 = xreward_2 and y_p0 = yreward_2;
      points_p1 = points_p1 + 1 if reward_2 = avail and turn = turn_p0 and x_p1 = xreward_2 and y_p1 = yreward_2;
      points_p0 = points_p0 + 1 if reward_3 = avail and turn = turn_p1 and x_p0 = xreward_3 and y_p0 = yreward_3;
      points_p1 = points_p1 + 1 if reward_3 = avail and turn = turn_p0 and x_p1 = xreward_3 and y_p1 = yreward_3;
      points_p0 = points_p0 + 1 if reward_4 = avail and turn = turn_p1 and x_p0 = xreward_4 and y_p0 = yreward_4;
      points_p1 = points_p1 + 1 if reward_4 = avail and turn = turn_p0 and x_p1 = xreward_4 and y_p1 = yreward_4;
end Evolution
end Agent

